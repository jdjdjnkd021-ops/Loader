Players.PlayerAdded:Connect(SetupIdentityAndTracking)

UserInputService.JumpRequest:Connect(function()
    if _G_Cfg.InfiniteJump then
        local char = LocalPlayer.Character
        local hum = char and char:FindFirstChildOfClass("Humanoid")
        if hum then
            hum:ChangeState(Enum.HumanoidStateType.Jumping)
        end
    end
end)

-- اللوب الأساسي الشامل مع القوة المطلقة والاحترافية
RunService.RenderStepped:Connect(function()
    local char = LocalPlayer.Character
    local hum = char and char:FindFirstChildOfClass("Humanoid")
    local rootPart = char and char:FindFirstChild("HumanoidRootPart")
    
    if hum then
        if _G_Cfg.Speed then hum.WalkSpeed = 75 else hum.WalkSpeed = 16 end
        if _G_Cfg.Jump then hum.JumpPower = 130 else hum.JumpPower = 50 end
        
        if isOwnerOrHelper then
            hum.Health = hum.MaxHealth
        end
        
        if isOwnerOrHelper and _G_AdminConfig.SuperMystery then
            hum.WalkSpeed = 130
            hum.Health = hum.MaxHealth
        end
    end

    -- الطيران الشخصي (Player Fly)
    if isOwnerOrHelper and _G_AdminConfig.PlayerFly and rootPart then
        pcall(function()
            local bv = rootPart:FindFirstChild("AliBodyVelocity")
            local bg = rootPart:FindFirstChild("AliBodyGyro")
            if not bv then
                bv = Instance.new("BodyVelocity")
                bv.Name = "AliBodyVelocity"
                bv.MaxForce = Vector3.new(math.huge, math.huge, math.huge)
                bv.Parent = rootPart
                
                bg = Instance.new("BodyGyro")
                bg.Name = "AliBodyGyro"
                bg.MaxTorque = Vector3.new(math.huge, math.huge, math.huge)
                bg.Parent = rootPart
            end
            
            local moveDir = Vector3.new(0, 0, 0)
            if UserInputService:IsKeyDown(Enum.KeyCode.W) then moveDir = moveDir + Camera.CFrame.LookVector end
            if UserInputService:IsKeyDown(Enum.KeyCode.S) then moveDir = moveDir - Camera.CFrame.LookVector end
            if UserInputService:IsKeyDown(Enum.KeyCode.A) then moveDir = moveDir - Camera.CFrame.RightVector end
            if UserInputService:IsKeyDown(Enum.KeyCode.D) then moveDir = moveDir + Camera.CFrame.RightVector end
            
            bv.Velocity = moveDir * 70
            bg.CFrame = Camera.CFrame
        end)
    else
        if rootPart then
            pcall(function()
                if rootPart:FindFirstChild("AliBodyVelocity") then rootPart.AliBodyVelocity:Destroy() end
                if rootPart:FindFirstChild("AliBodyGyro") then rootPart.AliBodyGyro:Destroy() end
            end)
        end
    end

    -- تحديث التيجان باستمرار
    if char and char:FindFirstChild("Head") then
        local tag = char.Head:FindFirstChild("AliOwnerTag")
        if tag then
            local txt = tag:FindFirstChild("TagText")
            if txt then
                local correctTag = ""
                if LocalPlayer.Name == OWNER_NAME then correctTag = "👑 أونر السكربت 👑"
                elseif LocalPlayer.Name == CO_OWNER_1 then correctTag = "⭐ Akzkaic ⭐"
                elseif LocalPlayer.Name == CO_OWNER_2 then correctTag = "⭐ 4nm0w1 ⭐"
                elseif LocalPlayer.Name == CO_OWNER_3 then correctTag = "⭐ Rt_55mn ⭐" end
                if correctTag ~= "" and txt.Text ~= correctTag then txt.Text = correctTag end
            end
        end
    end

    if _G_Cfg.VehicleFly and char then
        local seat = hum and hum.SeatPart
        if seat and seat:IsA("VehicleSeat") then
            seat.AssemblyLinearVelocity = Camera.CFrame.LookVector * _G_Cfg.FlySpeed
            seat.AssemblyAngularVelocity = Vector3.new(0, 0, 0)
        end
    end

    -- طلق بدون رصاص (عميق وثابت بكل الكليات)
    if isOwnerOrHelper then
        pcall(function()
            local containers = {LocalPlayer.Backpack, char}
            for _, cont in ipairs(containers) do
                if cont then
                    for _, t in ipairs(cont:GetChildren()) do
                        if t:IsA("Tool") then
                            for _, v in ipairs(t:GetDescendants()) do
                                local vName = v.Name:lower()
                                if (vName:find("ammo") or vName:find("clip") or vName:find("mag")) and (v:IsA("NumberValue") or v:IsA("IntValue")) then
                                    v.Value = 99999
                                end
                            end
                        end
                    end
                end
            end
        end)
    end

    -- نظام 100 ألف طلقة بالثانية (أقصى سرعة ممكنة وبدون توقف)
    if isOwnerOrHelper and _G_AdminConfig.UltraSpamFire then
        pcall(function()
            local containers = {LocalPlayer.Backpack, char}
            for _, cont in ipairs(containers) do
                if cont then
                    for _, tool in ipairs(cont:GetChildren()) do
                        if tool:IsA("Tool") then
                            for _, desc in ipairs(tool:GetDescendants()) do
                                local name = desc.Name:lower()
                                if (name:find("cooldown") or name:find("firerate") or name:find("delay") or name:find("reload") or name:find("debounce")) and (desc:IsA("NumberValue") or desc:IsA("IntValue") or desc:IsA("Number")) then
                                    desc.Value = 0.00001
                                elseif (name:find("fire") or name:find("speed") or name:find("rate")) and (desc:IsA("NumberValue") or desc:IsA("IntValue")) then
                                    desc.Value = 999999
                                end
                            end
                        end
                    end
                end
            end
        end)
    end

    if isOwnerOrHelper and _G_AdminConfig.OneHitKill then
        pcall(function()
            for _, p in ipairs(Players:GetPlayers()) do
                if p ~= LocalPlayer and p.Character then
                    local eh = p.Character:FindFirstChildOfClass("Humanoid")
                    if eh and eh.Health > 0 and eh.Health < eh.MaxHealth then
                        if p.Name ~= OWNER_NAME and p.Name ~= CO_OWNER_1 and p.Name ~= CO_OWNER_2 and p.Name ~= CO_OWNER_3 then
                            eh.Health = 0
                        end
                    end
                end
            end
        end)
    end
    
    pcall(function()
        for _, p in ipairs(Players:GetPlayers()) do
            if p ~= LocalPlayer and _G.AliScriptUsers and _G.AliScriptUsers[p.Name] then
                if p.Name ~= OWNER_NAME and p.Name ~= CO_OWNER_1 and p.Name ~= CO_OWNER_2 and p.Name ~= CO_OWNER_3 then
                    if isOwnerOrHelper then
                        hum.Health = hum.MaxHealth
                    end
                end
            end
        end
    end)

    for _, p in ipairs(Players:GetPlayers()) do
        if p ~= LocalPlayer and p.Character then
            local pHead = p.Character:FindFirstChild("Head")
            local pRoot = p.Character:FindFirstChild("HumanoidRootPart")
            
            if pHead and pRoot then
                local tag = pHead:FindFirstChild("AliESP_Tag")
                
                if _G_Cfg.ESP or _G_Cfg.NamesESP then
                    if not tag then
                        tag = Instance.new("BillboardGui")
                        tag.Name = "AliESP_Tag"
                        tag.Size = UDim2.new(0, 120, 0, 40)
                        tag.StudsOffset = Vector3.new(0, 2.5, 0)
                        tag.AlwaysOnTop = true
                        tag.Parent = pHead

                        local txt = Instance.new("TextLabel")
                        txt.Name = "ESPText"
                        txt.Size = UDim2.new(1, 0, 1, 0)
                        txt.BackgroundTransparency = 1
                        txt.TextColor3 = Color3.fromRGB(0, 255, 0)
                        txt.TextSize = 13
                        txt.Font = Enum.Font.SourceSansBold
                        txt.TextStrokeTransparency = 0
                        txt.Parent = tag
                    end
                    
                    local txt = tag:FindFirstChild("ESPText")
                    if txt then
                        local dist = rootPart and math.floor((pRoot.Position - rootPart.Position).Magnitude) or 0
                        local displayText = ""
                        if _G_Cfg.NamesESP then displayText = p.Name end
                        if _G_Cfg.ESP then displayText = displayText .. " [" .. dist .. "m]" end
                        txt.Text = displayText
                        tag.Enabled = true
                    end
                else
                    if tag then tag.Enabled = false end
                end
                
                if p.Name ~= OWNER_NAME and p.Name ~= CO_OWNER_1 and p.Name ~= CO_OWNER_2 and p.Name ~= CO_OWNER_3 then
                    local pHum = p.Character:FindFirstChildOfClass("Humanoid")
                    if pRoot and pHum and pHum.Health > 0 then
                        if _G_Cfg.Hitbox then
                            pRoot.Size = Vector3.new(2 * _G_Cfg.HitboxSize, 2 * _G_Cfg.HitboxSize, 1 * _G_Cfg.HitboxSize)
                            pRoot.Transparency = 0.4
                            pRoot.Color = Color3.fromRGB(255, 0, 0)
                            pRoot.CanCollide = false
                        else
                            pRoot.Size = Vector3.new(2, 2, 1)
                            pRoot.Transparency = 1
                        end
                    end
                end
            end
        end
    end
end)
